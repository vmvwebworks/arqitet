section.max-w-2xl.mx-auto.bg-gray-50.rounded-2xl.p-8.mt-10
  .mb-6
    h1.text-3xl.font-bold.text-gray-800.mb-2 Aplicar al Slot
    .bg-blue-50.border-l-4.border-blue-400.p-4.rounded
      h3.font-semibold.text-blue-800= @slot.role.titleize
      p.text-blue-700.text-sm= @slot.project.title
      - if @slot.description.present?
        p.text-blue-600.text-sm.mt-2= @slot.description
  
  = form_with model: [@slot.project, @slot, @application], local: true, class: "space-y-6" do |f|
    .space-y-4
      div
        = f.label :message, 'Mensaje de presentación', class: 'block.text-sm.font-medium.text-gray-700.mb-2'
        = f.text_area :message, 
          class: 'w-full.px-4.py-3.border.border-gray-300.rounded-lg.focus:ring-2.focus:ring-blue-500.focus:border-blue-500.resize-none', 
          rows: 6,
          placeholder: 'Cuéntanos sobre tu experiencia, habilidades y por qué te interesa este proyecto...'
      
      .bg-yellow-50.border.border-yellow-200.rounded-lg.p-4
        .flex.items-start.gap-2
          svg.w-5.h-5.text-yellow-600.mt-0.5 fill="none" stroke="currentColor" viewBox="0 0 24 24"
            path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          div
            h4.text-sm.font-medium.text-yellow-800 Información importante
            p.text-sm.text-yellow-700 Tu aplicación será revisada por el propietario del proyecto. Recibirás una notificación con la respuesta.
    
    .flex.gap-4.pt-4
      = f.submit 'Enviar aplicación', 
        class: 'flex-1.bg-blue-600.text-white.px-6.py-3.rounded-lg.font-medium.hover:bg-blue-700.transition-colors'
      = link_to 'Cancelar', @slot.project, 
        class: 'flex-1.bg-gray-200.text-gray-700.px-6.py-3.rounded-lg.font-medium.hover:bg-gray-300.transition-colors.text-center'
