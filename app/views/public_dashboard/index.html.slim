- content_for :title, user_signed_in? ? "Mi Dashboard" : "ArqiTet - Plataforma para Arquitectos"

- if user_signed_in?
  .min-h-screen.bg-gradient-to-br.from-slate-50.via-blue-50.to-indigo-50
    .container.mx-auto.px-6.py-8
      .flex.flex-col.lg:flex-row.gap-8
        
        // Dashboard principal
        main.flex-1
          .mb-8
            .bg-white.rounded-xl.shadow-sm.border.border-slate-200.p-6
              .flex.items-center.justify-between.mb-4
                h1.text-2xl.font-bold.text-slate-800 ¡Hola, #{current_user.full_name}!
                .text-sm.text-slate-500= Date.current.strftime("%d de %B de %Y")
              
              - unless current_user.confirmed?
                .bg-yellow-50.border.border-yellow-200.rounded-lg.p-4.mb-6
                  .flex.items-center.gap-3
                    .w-8.h-8.bg-yellow-100.rounded-full.flex.items-center.justify-center
                      i.fas.fa-exclamation-triangle.text-yellow-600.text-sm
                    div
                      h3.font-semibold.text-yellow-800 Confirma tu cuenta
                      p.text-sm.text-yellow-700.mt-1 
                        | Te hemos enviado un email de confirmación a 
                        span.font-medium= current_user.email
                        | . Revisa tu bandeja de entrada y spam.
                      .mt-3
                        = link_to "Reenviar confirmación", new_user_confirmation_path, 
                                  class: "text-sm font-medium text-yellow-700 hover:text-yellow-800 underline"
              
              .grid.grid-cols-1.sm:grid-cols-3.gap-4
                = link_to invoices_path, class: "group p-4 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg border border-blue-200 hover:from-blue-100 hover:to-blue-200 transition-all duration-200"
                  .flex.items-center.gap-3
                    .w-10.h-10.bg-blue-500.rounded-lg.flex.items-center.justify-center
                      i.fas.fa-file-invoice.text-white.text-sm
                    div
                      h3.font-semibold.text-blue-900.text-sm Facturas
                      p.text-xs.text-blue-700.mt-1 Gestiona tus facturas
                
                = link_to honorary_calculations_path, class: "group p-4 bg-gradient-to-br from-green-50 to-green-100 rounded-lg border border-green-200 hover:from-green-100 hover:to-green-200 transition-all duration-200"
                  .flex.items-center.gap-3
                    .w-10.h-10.bg-green-500.rounded-lg.flex.items-center.justify-center
                      i.fas.fa-calculator.text-white.text-sm
                    div
                      h3.font-semibold.text-green-900.text-sm Calculadora
                      p.text-xs.text-green-700.mt-1 Calcula honorarios
                
                = link_to clients_path, class: "group p-4 bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg border border-purple-200 hover:from-purple-100 hover:to-purple-200 transition-all duration-200"
                  .flex.items-center.gap-3
                    .w-10.h-10.bg-purple-500.rounded-lg.flex.items-center.justify-center
                      i.fas.fa-users.text-white.text-sm
                    div
                      h3.font-semibold.text-purple-900.text-sm CRM
                      p.text-xs.text-purple-700.mt-1 Gestiona clientes
          
          // Carrusel de proyectos
          .bg-white.rounded-xl.shadow-sm.border.border-slate-200.p-6.mb-6
            .flex.items-center.justify-between.mb-4
              h2.text-lg.font-bold.text-slate-800 Tus proyectos
              = link_to "Ver todos", projects_path, class: "text-sm font-medium text-blue-600 hover:text-blue-700"
            
            - if current_user.projects.any?
              .grid.grid-cols-1.sm:grid-cols-2.lg:grid-cols-3.gap-4
                - current_user.projects.limit(6).each do |project|
                  = link_to project_path(project), class: "block group"
                    .bg-slate-50.rounded-lg.border.border-slate-200.p-4.hover:border-blue-300.hover:shadow-sm.transition-all.duration-200
                      .flex.items-center.justify-between.mb-2
                        h3.font-medium.text-slate-900.text-sm.truncate.pr-2= project.title
                        .text-xs.px-2.py-1.bg-slate-200.text-slate-700.rounded-full= project.status
                      p.text-xs.text-slate-600.line-clamp-2= project.description
                      .mt-3.text-xs.text-slate-500= project.created_at.strftime('%d %b %Y')
            - else
              .text-center.py-8
                .w-16.h-16.bg-slate-100.rounded-full.flex.items-center.justify-center.mx-auto.mb-4
                  i.fas.fa-plus.text-slate-400.text-xl
                h3.text-slate-600.font-medium.mb-2 Aún no tienes proyectos
                p.text-sm.text-slate-500.mb-4 Crea tu primer proyecto y comienza a gestionar tu trabajo
                = link_to "Crear proyecto", new_project_path, 
                          class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors"
          
          // Widget de analíticas
          .grid.grid-cols-1.sm:grid-cols-2.gap-6
            .bg-white.rounded-xl.shadow-sm.border.border-slate-200.p-6
              h3.text-lg.font-bold.text-slate-800.mb-4 Resumen del mes
              .space-y-3
                .flex.items-center.justify-between
                  span.text-sm.text-slate-600 Proyectos activos
                  span.font-semibold.text-slate-900= current_user.projects.where(status: 'active').count
                .flex.items-center.justify-between
                  span.text-sm.text-slate-600 Facturas emitidas
                  span.font-semibold.text-slate-900= current_user.invoices.where(created_at: 1.month.ago..Time.current).count
                .flex.items-center.justify-between
                  span.text-sm.text-slate-600 Ingresos del mes
                  span.font-semibold.text-green-600= number_to_currency(current_user.invoices.where(created_at: 1.month.ago..Time.current).sum(:total_amount), unit: '€')
            
            .bg-white.rounded-xl.shadow-sm.border.border-slate-200.p-6
              h3.text-lg.font-bold.text-slate-800.mb-4 Actividad reciente
              .space-y-3
                - current_user.projects.limit(3).each do |project|
                  .flex.items-center.gap-3
                    .w-8.h-8.bg-blue-100.rounded-full.flex.items-center.justify-center
                      i.fas.fa-project-diagram.text-blue-600.text-xs
                    div
                      p.text-sm.font-medium.text-slate-900= project.title
                      p.text-xs.text-slate-500= "Actualizado #{time_ago_in_words(project.updated_at)} ago"
    
- else
  // Hero Section
  section.relative.bg-gradient-to-br.from-blue-50.via-indigo-50.to-purple-50.overflow-hidden
    .absolute.inset-0.bg-grid-pattern.opacity-5
    .relative.container.mx-auto.px-6.py-20.lg:py-32.text-center
      h1.text-4xl.lg:text-6xl.font-bold.text-gray-900.mb-6.leading-tight
        | La plataforma para 
        span.text-blue-600 arquitectos
        br
        | del siglo XXI
      
      p.text-lg.lg:text-xl.text-gray-600.mb-8.max-w-3xl.mx-auto.leading-relaxed
        | Gestiona tus proyectos, calcula honorarios, factura a clientes y conecta 
        | con la comunidad arquitectónica más grande del mundo
      
      .flex.flex-col.sm:flex-row.gap-4.justify-center.mb-16
        = link_to new_user_registration_path, 
                  class: "px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
          | Comienza gratis
        
        = link_to projects_path, 
                  class: "px-8 py-4 border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold rounded-xl transition-all duration-200"
          | Explorar proyectos
      
      .flex.items-center.justify-center.gap-8.opacity-60
        .text-sm.font-medium.text-gray-500 Integrado con:
        .flex.gap-6
          .text-gray-400.font-medium AutoCAD
          .text-gray-400.font-medium Revit
          .text-gray-400.font-medium SketchUp
  
  // Features Section
  section.py-20.bg-white
    .container.mx-auto.px-6
      .text-center.mb-16
        h2.text-3xl.lg:text-4xl.font-bold.text-gray-900.mb-4
          | Todo lo que necesitas para tu estudio
        p.text-lg.text-gray-600.max-w-2xl.mx-auto
          | Herramientas profesionales diseñadas específicamente para arquitectos y estudios de arquitectura
      
      .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-8
        .group.text-center.p-8.rounded-2xl.border.border-gray-100.hover:border-blue-200.hover:shadow-lg.transition-all.duration-300
          .w-16.h-16.bg-blue-100.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-6.group-hover:bg-blue-200.transition-colors
            i.fas.fa-project-diagram.text-blue-600.text-2xl
          h3.text-xl.font-bold.text-gray-900.mb-3 Gestión de Proyectos
          p.text-gray-600.leading-relaxed
            | Organiza y administra todos tus proyectos desde una plataforma centralizada con herramientas colaborativas
        
        .group.text-center.p-8.rounded-2xl.border.border-gray-100.hover:border-green-200.hover:shadow-lg.transition-all.duration-300
          .w-16.h-16.bg-green-100.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-6.group-hover:bg-green-200.transition-colors
            i.fas.fa-calculator.text-green-600.text-2xl
          h3.text-xl.font-bold.text-gray-900.mb-3 Cálculo de Honorarios
          p.text-gray-600.leading-relaxed
            | Calcula honorarios profesionales automáticamente según normativas vigentes y baremos oficiales
        
        .group.text-center.p-8.rounded-2xl.border.border-gray-100.hover:border-purple-200.hover:shadow-lg.transition-all.duration-300
          .w-16.h-16.bg-purple-100.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-6.group-hover:bg-purple-200.transition-colors
            i.fas.fa-file-invoice.text-purple-600.text-2xl
          h3.text-xl.font-bold.text-gray-900.mb-3 Facturación
          p.text-gray-600.leading-relaxed
            | Genera facturas profesionales y mantén un control completo de tu facturación y pagos
        
        .group.text-center.p-8.rounded-2xl.border.border-gray-100.hover:border-orange-200.hover:shadow-lg.transition-all.duration-300
          .w-16.h-16.bg-orange-100.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-6.group-hover:bg-orange-200.transition-colors
            i.fas.fa-users.text-orange-600.text-2xl
          h3.text-xl.font-bold.text-gray-900.mb-3 CRM de Clientes
          p.text-gray-600.leading-relaxed
            | Gestiona la relación con tus clientes, historial de proyectos y comunicaciones centralizadas
        
        .group.text-center.p-8.rounded-2xl.border.border-gray-100.hover:border-red-200.hover:shadow-lg.transition-all.duration-300
          .w-16.h-16.bg-red-100.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-6.group-hover:bg-red-200.transition-colors
            i.fas.fa-chart-line.text-red-600.text-2xl
          h3.text-xl.font-bold.text-gray-900.mb-3 Analíticas
          p.text-gray-600.leading-relaxed
            | Obtén insights detallados sobre el rendimiento de tus proyectos y la salud de tu negocio
        
        .group.text-center.p-8.rounded-2xl.border.border-gray-100.hover:border-indigo-200.hover:shadow-lg.transition-all.duration-300
          .w-16.h-16.bg-indigo-100.rounded-2xl.flex.items-center.justify-center.mx-auto.mb-6.group-hover:bg-indigo-200.transition-colors
            i.fas.fa-comments.text-indigo-600.text-2xl
          h3.text-xl.font-bold.text-gray-900.mb-3 Colaboración
          p.text-gray-600.leading-relaxed
            | Colabora en tiempo real con tu equipo y clientes en cada proyecto con herramientas integradas
  
  // Stats Section
  section.py-20.bg-gray-50
    .container.mx-auto.px-6
      .text-center.mb-16
        h2.text-3xl.font-bold.text-gray-900.mb-4 La comunidad crece cada día
        p.text-lg.text-gray-600 Miles de arquitectos ya confían en nuestra plataforma
      
      .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-4.gap-8.mb-12
        .text-center.p-6
          .w-20.h-20.bg-blue-100.rounded-full.flex.items-center.justify-center.mx-auto.mb-4
            span.text-3xl.font-bold.text-blue-600= @platform_stats[:projects_count]
          h3.text-xl.font-semibold.text-gray-900.mb-2 Proyectos
          p.text-gray-600 Proyectos publicados en la plataforma
        
        .text-center.p-6
          .w-20.h-20.bg-green-100.rounded-full.flex.items-center.justify-center.mx-auto.mb-4
            span.text-3xl.font-bold.text-green-600= @platform_stats[:users_count]
          h3.text-xl.font-semibold.text-gray-900.mb-2 Usuarios
          p.text-gray-600 Arquitectos registrados
        
        .text-center.p-6
          .w-20.h-20.bg-purple-100.rounded-full.flex.items-center.justify-center.mx-auto.mb-4
            span.text-3xl.font-bold.text-purple-600 24h
          h3.text-xl.font-semibold.text-gray-900.mb-2 Soporte
          p.text-gray-600 Asistencia profesional
        
        .text-center.p-6
          .w-20.h-20.bg-orange-100.rounded-full.flex.items-center.justify-center.mx-auto.mb-4
            span.text-3xl.font-bold.text-orange-600 99%
          h3.text-xl.font-semibold.text-gray-900.mb-2 Uptime
          p.text-gray-600 Disponibilidad garantizada
      
      .text-center
        h3.text-2xl.font-semibold.text-gray-900.mb-6 Proyectos por especialidad
        .flex.flex-wrap.justify-center.gap-3.mb-8
          - @platform_stats[:categories].each do |cat, count|
            .px-4.py-2.bg-white.border.border-gray-200.text-gray-700.rounded-full.font-medium.hover:border-blue-200.transition-colors
              = "#{cat}: #{count}"
  
  // Projects Showcase Section
  section.py-20.bg-white
    .container.mx-auto.px-6
      .text-center.mb-16
        h2.text-3xl.font-bold.text-gray-900.mb-4 Proyectos destacados
        p.text-lg.text-gray-600 Descubre el trabajo de nuestra comunidad de arquitectos
      
      - if @platform_stats[:recent_projects].present?
        .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-8.mb-12
          - @platform_stats[:recent_projects].limit(6).each do |project|
            .group.bg-white.rounded-xl.border.border-gray-200.hover:border-blue-200.hover:shadow-lg.transition-all.duration-300.overflow-hidden
              .p-6
                .flex.items-center.justify-between.mb-3
                  h3.font-semibold.text-gray-900.text-lg= project.title
                  .text-xs.px-3.py-1.bg-blue-100.text-blue-700.rounded-full= project.category || 'Residencial'
                p.text-gray-600.text-sm.line-clamp-3.mb-4= project.description
                .flex.items-center.justify-between
                  .text-xs.text-gray-500= project.created_at.strftime('%d de %B, %Y')
                  .text-xs.font-medium.text-blue-600 Ver proyecto →
        
        .text-center
          = link_to projects_path, 
                    class: "inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors"
            | Ver todos los proyectos
            i.fas.fa-arrow-right.ml-2
      - else
        .text-center.py-12
          .w-16.h-16.bg-gray-100.rounded-full.flex.items-center.justify-center.mx-auto.mb-4
            i.fas.fa-building.text-gray-400.text-xl
          p.text-gray-500 Pronto tendremos proyectos destacados para mostrar
  
  // CTA Section
  section.py-20.bg-gradient-to-br.from-blue-600.via-blue-700.to-indigo-700.text-white
    .container.mx-auto.px-6.text-center
      h2.text-3xl.lg:text-4xl.font-bold.mb-4
        | ¿Listo para revolucionar tu práctica arquitectónica?
      p.text-lg.lg:text-xl.mb-8.opacity-90.max-w-2xl.mx-auto
        | Únete a miles de arquitectos que ya están transformando su forma de trabajar
      
      .flex.flex-col.sm:flex-row.gap-4.justify-center
        = link_to new_user_registration_path, 
                  class: "px-8 py-4 bg-white text-blue-600 hover:bg-gray-50 font-semibold rounded-xl transition-all duration-200 shadow-lg"
          | Crear cuenta gratuita
        
        = link_to new_user_session_path, 
                  class: "px-8 py-4 border-2 border-white text-white hover:bg-white hover:text-blue-600 font-semibold rounded-xl transition-all duration-200"
          | Iniciar sesión
