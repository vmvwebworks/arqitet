section.max-w-6xl.mx-auto.bg-gray-50.rounded-2xl.p-8.mt-10
  .mb-6
    .flex.items-center.gap-4.mb-4
      = link_to @project, class: "text-blue-600.hover:text-blue-800.flex.items-center.gap-2"
        svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
        | Volver al proyecto
    
    h1.text-3xl.font-bold.text-gray-800.mb-2 Buscar Profesionales
    p.text-gray-600= "Para el proyecto: #{@project.title}"

  / Formulario de búsqueda
  .bg-white.rounded-lg.p-6.mb-6
    = form_with url: search_professionals_project_path(@project), method: :get, local: true, class: "space-y-4" do |f|
      .grid.md:grid-cols-2.gap-4
        div
          = f.label :query, 'Buscar por nombre', class: 'block.text-sm.font-medium.text-gray-700.mb-2'
          = f.text_field :query, 
            value: params[:query],
            placeholder: "Nombre del profesional...",
            class: 'w-full.px-4.py-3.border.border-gray-300.rounded-lg.focus:ring-2.focus:ring-blue-500.focus:border-blue-500'
        
        div
          = f.label :specialty, 'Especialidad', class: 'block.text-sm.font-medium.text-gray-700.mb-2'
          = f.select :specialty, 
            options_for_select([
              ['Todas las especialidades', ''],
              ['Arquitecto', 'arquitecto'],
              ['Ingeniero', 'ingeniero'],
              ['Diseñador', 'diseñador'],
              ['Urbanista', 'urbanista'],
              ['Paisajista', 'paisajista']
            ], params[:specialty]),
            {},
            class: 'w-full.px-4.py-3.border.border-gray-300.rounded-lg.focus:ring-2.focus:ring-blue-500.focus:border-blue-500'
      
      .flex.gap-4
        = f.submit 'Buscar', class: 'bg-blue-600.text-white.px-6.py-3.rounded-lg.font-medium.hover:bg-blue-700.transition-colors'
        = link_to 'Limpiar filtros', search_professionals_project_path(@project), class: 'bg-gray-200.text-gray-700.px-6.py-3.rounded-lg.font-medium.hover:bg-gray-300.transition-colors'

  / Resultados
  - if @professionals.any?
    .grid.md:grid-cols-2.lg:grid-cols-3.gap-6
      - @professionals.each do |professional|
        .bg-white.rounded-lg.p-6
          .flex.items-center.gap-4.mb-4
            .w-16.h-16.bg-gradient-to-br.from-blue-500.to-blue-600.rounded-full.flex.items-center.justify-center.text-white.font-bold.text-xl
              = professional.full_name.split.map(&:first).join.upcase
            div
              h3.font-semibold.text-gray-800= professional.full_name
              - if professional.specialty.present?
                p.text-sm.text-gray-600= professional.specialty.titleize
              - if professional.location.present?
                p.text-xs.text-gray-500= professional.location
          
          - if professional.bio.present?
            p.text-sm.text-gray-600.mb-4= truncate(professional.bio, length: 120)
          
          .flex.gap-2
            = link_to professional, class: "flex-1.text-center.bg-blue-100.text-blue-700.px-4.py-2.rounded-lg.text-sm.font-medium.hover:bg-blue-200.transition"
              | Ver perfil
            - if @project.project_slots.available.any?
              .flex-1
                select.w-full.text-xs.bg-green-100.text-green-700.px-3.py-2.rounded-lg.border-0 onchange="assignToSlot(#{professional.id}, this.value)"
                  option value="" Asignar a slot...
                  - @project.project_slots.available.each do |slot|
                    option value="#{slot.id}" = slot.role.titleize
  - else
    .text-center.py-12.text-gray-500
      svg.w-16.h-16.mx-auto.mb-4.text-gray-300 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
      h3.text-lg.font-medium.text-gray-600.mb-2 No se encontraron profesionales
      p.text-gray-500 Intenta ajustar los filtros de búsqueda

javascript:
  function assignToSlot(userId, slotId) {
    if (slotId) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/projects/#{@project.id}/project_slots/${slotId}/assign`;
      
      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = csrfToken;
      
      const userInput = document.createElement('input');
      userInput.type = 'hidden';
      userInput.name = 'user_id';
      userInput.value = userId;
      
      form.appendChild(csrfInput);
      form.appendChild(userInput);
      document.body.appendChild(form);
      form.submit();
    }
  }