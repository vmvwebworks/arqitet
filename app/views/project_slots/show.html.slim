section.max-w-4xl.mx-auto.bg-gray-50.rounded-2xl.p-8.mt-10
  .mb-6
    .flex.items-center.gap-4.mb-4
      = link_to @slot.project, class: "text-blue-600.hover:text-blue-800.flex.items-center.gap-2"
        svg.w-4.h-4 fill="none" stroke="currentColor" viewBox="0 0 24 24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
        | Volver al proyecto
    
    h1.text-3xl.font-bold.text-gray-800.mb-2 
      | Aplicaciones para: #{@slot.role.titleize}
    .bg-blue-50.border-l-4.border-blue-400.p-4.rounded
      h3.font-semibold.text-blue-800= @slot.project.title
      - if @slot.description.present?
        p.text-blue-600.text-sm.mt-2= @slot.description

  - if @slot.slot_applications.pending.any?
    .space-y-4
      - @slot.slot_applications.pending.recent.each do |application|
        .bg-white.rounded-lg.p-6.border.border-gray-200
          .flex.items-start.justify-between.mb-4
            .flex.items-center.gap-4
              .w-12.h-12.bg-gradient-to-br.from-blue-500.to-blue-600.rounded-full.flex.items-center.justify-center.text-white.font-bold
                = application.user.full_name.split.map(&:first).join.upcase
              div
                h3.font-semibold.text-gray-800= application.user.full_name
                - if application.user.specialty.present?
                  p.text-sm.text-gray-600= application.user.specialty
                p.text-xs.text-gray-500= "Aplicó #{time_ago_in_words(application.created_at)} atrás"
            
            .flex.gap-2
              = button_to accept_project_project_slot_slot_application_path(@slot.project, @slot, application), 
                method: :patch,
                data: { confirm: "¿Estás seguro de aceptar esta aplicación?" },
                class: "px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-medium hover:bg-green-600 transition",
                form_class: "inline"
                | Aceptar
              = button_to reject_project_project_slot_slot_application_path(@slot.project, @slot, application), 
                method: :patch,
                data: { confirm: "¿Estás seguro de rechazar esta aplicación?" },
                class: "px-4 py-2 bg-red-500 text-white rounded-lg text-sm font-medium hover:bg-red-600 transition",
                form_class: "inline"
                | Rechazar
          
          - if application.message.present?
            .bg-gray-50.rounded-lg.p-4
              h4.text-sm.font-medium.text-gray-700.mb-2 Mensaje de presentación:
              p.text-gray-600.text-sm= application.message
  - else
    .text-center.py-12.text-gray-500
      svg.w-16.h-16.mx-auto.mb-4.text-gray-300 fill="none" stroke="currentColor" viewBox="0 0 24 24"
        path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2M4 13h2m8-6v2m0 6v2"
      h3.text-lg.font-medium.text-gray-600.mb-2 No hay aplicaciones pendientes
      p.text-gray-500 Aún no has recibido aplicaciones para este slot.